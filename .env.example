# ============================================================================
# REAL-TIME FINANCIAL FRAUD DETECTION PLATFORM - ENVIRONMENT TEMPLATE
# ============================================================================
# Copy this template to '.env' before starting the application:
#   Windows:  Copy-Item .env.example .env
#   Linux:    cp .env.example .env
#
# IMPORTANT: Never commit the active '.env' file containing real credentials
# to version control. The repository '.gitignore' and '.dockerignore' exclude it.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Application & Web Control Center
# ----------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
FRONTEND_ORIGIN=http://localhost:5173
CONTROL_CENTER_DB=backend/data/control_center.sqlite3

# ----------------------------------------------------------------------------
# 2. Google Gemini Generative AI (Sole LLM Provider)
# ----------------------------------------------------------------------------
# Required for RAG automated investigations and AI assistant reasoning.
# Obtain a key at: https://aistudio.google.com/
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ----------------------------------------------------------------------------
# 3. Apache Kafka Event Streaming
# ----------------------------------------------------------------------------
# Use 'localhost:9092' for host development or 'kafka:29092' inside Docker network
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TRANSACTIONS_TOPIC=transactions
FRAUD_ALERTS_TOPIC=fraud-alerts
LOW_RISK_TOPIC=low-risk-transactions
INVESTIGATION_RESULTS_TOPIC=investigation-results
KAFKA_INVESTIGATION_CONSUMER_GROUP=fraud-investigation-service
FRAUD_INVESTIGATION_DLQ_TOPIC=fraud-investigation-dead-letter

# ----------------------------------------------------------------------------
# 4. Apache Cassandra Persistent Storage
# ----------------------------------------------------------------------------
# Use 'localhost' for host development or 'cassandra' inside Docker network
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fraud_detection
CASSANDRA_LOCAL_DC=datacenter1

# ----------------------------------------------------------------------------
# 5. Chroma Vector Database & RAG Retrieval
# ----------------------------------------------------------------------------
VECTOR_DB_PATH=vector_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_KNOWLEDGE_COLLECTION=fraud_knowledge
CHROMA_PAYSIM_COLLECTION=paysim_cases
RAG_TOP_K_KNOWLEDGE=5
RAG_TOP_K_PAYSIM=5
RAG_MAX_CONTEXT_TRANSACTIONS=20
RAG_MAX_CONTEXT_ALERTS=10
CASSANDRA_RECENT_TRANSACTION_LIMIT=20
CASSANDRA_RECENT_ALERT_LIMIT=10

# ----------------------------------------------------------------------------
# 6. Apache Spark Structured Streaming
# ----------------------------------------------------------------------------
SPARK_APP_NAME=FraudDetectionStreaming
SPARK_MASTER=local[2]
SPARK_MAX_OFFSETS_PER_TRIGGER=500
SPARK_CHECKPOINT_DIR=checkpoints
SPARK_METRICS_PORT=8002

# ----------------------------------------------------------------------------
# 7. Observability & Telemetry (Prometheus, Grafana, Alertmanager)
# ----------------------------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here
ALERTMANAGER_URL=http://localhost:9093
METRICS_HOST=0.0.0.0
METRICS_PORT=8000
PRODUCER_METRICS_PORT=8003
