{
  "uid": "fraud-rag-llm",
  "title": "RAG and LLM Investigation",
  "tags": ["fraud", "rag", "llm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "title": "RAG retrievals / sec", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "sum by (status) (rate(fraud_pipeline_events_total{component=\"rag\",event=\"retrieval\"}[5m]))", "legendFormat": "{{status}}", "refId": "A"}]},
    {"id": 2, "title": "LLM generations / sec", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "sum by (status) (rate(fraud_pipeline_events_total{component=\"llm\",event=\"generation\"}[5m]))", "legendFormat": "{{status}}", "refId": "A"}]},
    {"id": 3, "title": "Investigation latency p95 (seconds)", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(fraud_pipeline_duration_seconds_bucket{component=\"investigation\"}[5m])))", "legendFormat": "p95", "refId": "A"}]},
    {"id": 4, "title": "Investigation outcomes / sec", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "sum by (status) (rate(fraud_pipeline_events_total{component=\"investigation\",event=\"completed\"}[5m]))", "legendFormat": "{{status}}", "refId": "A"}]}
  ]
}
