# ============================================================
# Local Application Settings
# ============================================================

APP_ENV=development
LOG_LEVEL=INFO


# ============================================================
# Kafka
# ============================================================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Main transaction stream
TRANSACTIONS_TOPIC=transactions

# Spark's XGBoost low-risk output
LOW_RISK_TOPIC=low-risk-transactions

# Fraud alert stream
FRAUD_ALERTS_TOPIC=fraud-alerts

# RAG / LLM investigation result stream
INVESTIGATION_RESULTS_TOPIC=investigation-results

# Invalid / failed transaction stream
DEAD_LETTER_TOPIC=dead-letter-transactions

# Consumer groups
KAFKA_STREAMING_CONSUMER_GROUP=fraud-detection-streaming
KAFKA_ALERT_CONSUMER_GROUP=fraud-alert-service
KAFKA_INVESTIGATION_CONSUMER_GROUP=fraud-investigation-service

# Cassandra persistence consumers use independent groups
CASSANDRA_TRANSACTION_CONSUMER_GROUP=fraud-transaction-cassandra-service
CASSANDRA_FRAUD_ALERT_CONSUMER_GROUP=fraud-alert-cassandra-service

# Kafka partition design
TRANSACTIONS_PARTITIONS=6
FRAUD_ALERTS_PARTITIONS=6
INVESTIGATION_RESULTS_PARTITIONS=3
DEAD_LETTER_PARTITIONS=3


# ============================================================
# Spark
# ============================================================

SPARK_APP_NAME=fraud-detection
SPARK_MASTER=local[2]

# Local checkpoint directory
SPARK_CHECKPOINT_DIR=./checkpoints

# Serialized Isolation Forest model
MODEL_PATH=./models/isolation_forest_final.pkl

# Model metadata
MODEL_FEATURES_PATH=./models/isolation_forest_features.json
MODEL_CONFIG_PATH=./models/isolation_forest_config.json


# ============================================================
# Data Sources
# ============================================================

DATASET_PATH=./data/PS_20174392719_1491204439457_log.csv
TRAINING_OUTPUT_DIR=./models


# ============================================================
# Cassandra
# ============================================================

CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fraud_detection
CASSANDRA_LOCAL_DC=datacenter1


# ============================================================
# MongoDB
# ============================================================
# Currently not part of the main pipeline.
# Keep these only if another existing component still uses MongoDB.

MONGO_URI=mongodb://localhost:27017
MONGO_DB=fraud_detection
MONGO_COLLECTION=transactions


# ============================================================
# RAG / Vector Database
# ============================================================

VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./vector_db

RAG_TOP_K=5


# ============================================================
# LLM
# ============================================================

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048


# ============================================================
# Monitoring
# ============================================================

GRAFANA_URL=http://localhost:3000

PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_PORT=9090


# ============================================================
# ML
# ============================================================

MODEL_TYPE=IsolationForest

# NOTE:
# Do not interpret this as "95% fraud probability".
# The final production-style thresholds will be T1, T2, T3, T4
# derived from validation data.

RISK_THRESHOLD_T1=
RISK_THRESHOLD_T2=
RISK_THRESHOLD_T3=
RISK_THRESHOLD_T4=


# ============================================================
# Security
# ============================================================

# Add real secrets only in your local .env file.
# Never commit credentials, API keys, or private endpoints.
LLM_PROVIDER=gemini
GEMINI_API_KEY=AQ.Ab8RN6LBc-OAYdzaRqvTtPlboZbmAbMKMF-Vrf-T5HROfJ-x_w
GEMINI_MODEL=gemini-3.5-flash-lite
