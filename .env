# Local application settings
APP_ENV=development
LOG_LEVEL=INFO

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TRANSACTIONS_TOPIC=transactions
KAFKA_CONSUMER_GROUP=fraud-detection-group

# Spark
SPARK_APP_NAME=fraud-detection
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=/tmp/checkpoints
MODEL_PATH=./models/model.pkl

# Data sources
DATASET_PATH=./data/paysim.csv
TRAINING_OUTPUT_DIR=./models

# MongoDB / Cassandra
MONGO_URI=mongodb://localhost:27017
MONGO_DB=fraud_detection
MONGO_COLLECTION=transactions
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fraud_detection

# Alerting and monitoring
ALERTS_DB_HOST=localhost
ALERTS_DB_PORT=27017
GRAFANA_URL=http://localhost:3000
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_PORT=9090

# ML tuning
MODEL_TYPE=IsolationForest
ANOMALY_THRESHOLD=0.95

# Add real secrets only in your local machine environment file.
# Do not commit production credentials or company-specific endpoints.
